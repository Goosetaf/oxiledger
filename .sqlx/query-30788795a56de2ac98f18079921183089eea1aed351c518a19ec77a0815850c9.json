  "query": "\n            SELECT\n                ba.provider_account_uid,\n                ba.last_synced_at,\n                bc.provider_id,\n                bc.provider_session_id\n            FROM bank_accounts ba\n            JOIN bank_connections bc ON bc.id = ba.bank_connection_id\n            WHERE ba.id = $1 AND ba.user_id = $2\n            ",
