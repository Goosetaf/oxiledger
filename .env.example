DATABASE_URL=postgres://postgres:password@localhost/oxiledger

# Base URL used to construct callback URLs (required for bank sync and OIDC)
BASE_URL=http://localhost:8080

# Enable Banking provider (https://enablebanking.com)
# ENABLE_BANKING_APP_ID=your-application-id
# ENABLE_BANKING_PRIVATE_KEY_PATH=/path/to/private.key
# ENABLE_BANKING_ENVIRONMENT=SANDBOX

# GoCardless Bank Account Data provider (https://developer.gocardless.com/bank-account-data)
# GOCARDLESS_SECRET_ID=your-secret-id
# GOCARDLESS_SECRET_KEY=your-secret-key
# GOCARDLESS_ENVIRONMENT=SANDBOX

# Bank sync caching and auto-sync
# BANK_SYNC_MODE=lazy
# BANK_SYNC_TTL_SECONDS=3600
# BANK_SYNC_SCHEDULE=0 * * * *
